{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "analyze": "npx vite-bundle-analyzer dist",
    "lighthouse": "npx lighthouse http://localhost:5173 --output html --output-path ./lighthouse-report.html",
    "audit:a11y": "npx @axe-core/cli http://localhost:5173",
    "test:build": "npm run build && npm run preview",
    "setup:emailjs": "node emailjs-setup.js"
  },
  "dependencies": {
